APP_NAME="The Journey Association"
APP_ENV=production
APP_KEY=          # copy from your current production .env
APP_DEBUG=false
APP_URL=https://api.thejourney-ma.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Database (Hostinger MySQL) ────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=srv2058.hstgr.io
DB_PORT=3306
DB_DATABASE=u613266227_test
DB_USERNAME=u613266227_test
DB_PASSWORD=           # your Hostinger MySQL password

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.thejourney-ma.org

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=thejourney-ma.org,www.thejourney-ma.org

# ── Mail (Hostinger SMTP) ─────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@thejourney-ma.org
MAIL_PASSWORD=         # your Hostinger email password
MAIL_FROM_ADDRESS="noreply@thejourney-ma.org"
MAIL_FROM_NAME="The Journey Association"

# ── Cache / Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
